{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReformANY",
  "version": "0.1.0",
  "identifier": "app.reformany.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReformANY",
        "width": 1120,
        "height": 760,
        "minWidth": 750,
        "minHeight": 580,
        "center": true,
        "backgroundColor": "#F7F7F5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
